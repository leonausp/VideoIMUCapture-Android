<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="wrap_content"
    tools:layout_height="match_parent"
    android:layout_width="match_parent"
    android:layout_weight="1"
    tools:context="se.lth.math.videoimucapture.CameraCaptureFragment">

    <se.lth.math.videoimucapture.AspectFrameLayout
        android:id="@+id/cameraPreview_afl"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <se.lth.math.videoimucapture.SampleGLView
            android:id="@+id/cameraPreview_surfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

    </se.lth.math.videoimucapture.AspectFrameLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/cameraParams_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="[?]"
        android:textAppearance="@style/TextAppearance.MyApp.Overlay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/captureResult_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:lineSpacingExtra="2dp"
        tools:text="Lens 6.81 mm  ·  f 895 px"
        android:textAppearance="@style/TextAppearance.MyApp.Overlay"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cameraParams_text" />


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/OIS_warning_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|bottom"
        android:layout_margin="16dp"
        android:contentDescription="@string/warning_icon_desc"
        android:src="@drawable/ic_warning_24"
        app:backgroundTint="@null"
        app:fabSize="mini"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@null" />

    <!-- Torch. Visible rather than buried, because in the dark it is the only control
         that adds actual photons — everything else trades blur against noise. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/torch_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="48dp"
        android:contentDescription="@string/torch_description"
        android:src="@drawable/ic_torch"
        app:backgroundTint="@color/torchOffBkg"
        app:fabSize="mini"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/capture_controls_row"
        app:tint="@null" />

    <!-- Recordings (the session browser), bottom left like a camera app's gallery. Mirrors the
         torch on the right; marginTop 8dp centres a 40dp mini FAB on the 56dp record button. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/gallery_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="48dp"
        android:contentDescription="@string/gallery_description"
        android:src="@drawable/ic_gallery"
        app:backgroundTint="@color/torchOffBkg"
        app:fabSize="mini"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/capture_controls_row"
        app:tint="@null" />

    <!-- Mode strip: all three visible at once, current one lit, one tap to change.
         The capture button then has exactly one meaning at any moment and the operator
         never has to remember hidden state or discover a long-press.

         It is constrained above the BUTTON ROW, not above one button. The first version
         centred this strip and centred the record button beneath it, leaving the capture
         button off to one side — so the obvious thing to press after choosing WALK was the
         big centred button directly below the word WALK, which recorded video. That is
         what happened on 2026-08-01: a WALK mode session nine seconds long and stationary,
         then a video recording during which the operator actually walked. The strip now
         governs a row, and each button says underneath it what it does. -->
    <LinearLayout
        android:id="@+id/captureMode_strip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/capture_controls_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mode_walk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:text="WALK"
            android:textAppearance="@style/TextAppearance.MyApp.Overlay" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mode_object"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:text="OBJECT"
            android:textAppearance="@style/TextAppearance.MyApp.Overlay" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mode_pano"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:text="PANO"
            android:textAppearance="@style/TextAppearance.MyApp.Overlay" />
    </LinearLayout>

    <!-- Transient status, on its own line so it can never overwrite the mode. -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/captureStatus_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text=""
        android:textAppearance="@style/TextAppearance.MyApp.Overlay"
        app:layout_constraintBottom_toTopOf="@+id/captureMode_strip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Two instruments, side by side and symmetric about the centre, each captioned.
         Neither sits in the "primary" centre slot, because neither is primary: stills and
         video answer different questions and the mode above decides the discipline that
         applies to whichever is pressed. -->
    <LinearLayout
        android:id="@+id/capture_controls_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/capture_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/capture_description"
                android:src="@drawable/ic_capture_still"
                app:backgroundTint="@color/captureButtonBkg"
                app:tint="@null" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/capture_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/capture_label_stills"
                android:textAppearance="@style/TextAppearance.MyApp.Overlay" />
        </LinearLayout>

        <android.widget.Space
            android:id="@+id/capture_controls_space"
            android:layout_width="56dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/toggleRecording_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/record_description"
                android:src="@drawable/ic_start_record"
                app:backgroundTint="@color/recordButtonBkg"
                app:tint="@null" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/record_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/capture_label_video"
                android:textAppearance="@style/TextAppearance.MyApp.Overlay" />
        </LinearLayout>
    </LinearLayout>

    <!-- Exposure on the preview: stacked buttons in the bottom-right corner, level with
         RECORD (focus, exposure time, ISO). Tapping one opens the adjust bar above them; values are the same settings as on the settings
         screen and apply to the preview at once. Locked while recording. -->
    <LinearLayout
        android:id="@+id/exposure_chips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/capture_controls_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/capture_controls_row">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/focus_chip"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textSize="13sp"
            android:minHeight="0dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:backgroundTint="#99000000"
            app:strokeColor="#CCFFFFFF"
            android:maxLines="1"
            tools:text="Focus: tap" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exposure_chip"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textSize="13sp"
            android:minHeight="0dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:backgroundTint="#99000000"
            app:strokeColor="#CCFFFFFF"
            tools:text="5.0 ms" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/iso_chip"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:textSize="13sp"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:backgroundTint="#99000000"
            app:strokeColor="#CCFFFFFF"
            tools:text="ISO auto 4740"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Adjust bar for the chosen value: - / value (tap to type) / + , and AUTO for ISO. -->
    <LinearLayout
        android:id="@+id/exposure_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/exposure_chips"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/panel_minus"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:text="@string/exposure_minus"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/panel_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="96dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            tools:text="5.0 ms" />

        <Button
            android:id="@+id/panel_plus"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:text="@string/exposure_plus"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <Button
            android:id="@+id/panel_auto"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:text="@string/exposure_auto"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/panel_af"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:text="@string/focus_af"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>